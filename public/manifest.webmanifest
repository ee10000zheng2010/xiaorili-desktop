{
  "name": "小日历",
  "short_name": "小日历",
  "description": "轻量的跨设备待办与日历工具",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#f0fdfa",
  "theme_color": "#0d9488",
  "lang": "zh-CN",
  "icons": [
    { "src": "./assets/app-icon.png", "sizes": "256x256", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "image", "accept": ["image/*"] }] }
  }
}
